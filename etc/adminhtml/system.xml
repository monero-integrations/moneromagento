<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
                <group id="custompayment" translate="label" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Monero Payment</label>
                    <field id="active" translate="label comment" sortOrder="1" type="select" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Enable</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <backend_model>MoneroIntegrations\Custompayment\Model\Config\Backend\PaymentSettings</backend_model>
                    </field>
                    <field id="title" translate="label comment" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Title</label>
                        <comment>Shown to customers at checkout and in order payment information.</comment>
                        <validate>required-entry validate-no-html-tags</validate>
                    </field>
                    <field id="rpc_address" translate="label comment" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Wallet-RPC Host</label>
                        <comment>Host or IP only, without protocol, port, or path. Use 127.0.0.1 when wallet-rpc is local or reached through an SSH tunnel.</comment>
                        <validate>validate-no-html-tags</validate>
                        <backend_model>MoneroIntegrations\Custompayment\Model\Config\Backend\PaymentSettings</backend_model>
                    </field>
                    <field id="rpc_port" translate="label" type="text" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Wallet-RPC Port</label>
                        <validate>required-entry validate-digits validate-greater-than-zero</validate>
                        <backend_model>MoneroIntegrations\Custompayment\Model\Config\Backend\PaymentSettings</backend_model>
                    </field>
                    <field id="rpc_username" translate="label comment" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Wallet-RPC Username</label>
                        <comment>Leave blank only when monero-wallet-rpc is started with --disable-rpc-login.</comment>
                    </field>
                    <field id="rpc_password" translate="label comment" type="obscure" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Wallet-RPC Password</label>
                        <comment>Used with monero-wallet-rpc --rpc-login.</comment>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    </field>
                    <field id="rpc_use_https" translate="label comment" sortOrder="7" type="select" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Use HTTPS for Wallet-RPC</label>
                        <comment>Required for non-local wallet-rpc hosts. Leave No for localhost or SSH-tunneled RPC.</comment>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <backend_model>MoneroIntegrations\Custompayment\Model\Config\Backend\PaymentSettings</backend_model>
                    </field>
                    <field id="num_confirmations" translate="label comment" type="text" sortOrder="8" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Number of Confirmations</label>
                        <comment>Number of blockchain confirmations required before considering the payment successful. Use `0` to accept the first mined transaction; pool transactions are not final.</comment>
                        <validate>validate-digits validate-zero-or-greater</validate>
                        <backend_model>MoneroIntegrations\Custompayment\Model\Config\Backend\PaymentSettings</backend_model>
                    </field>
                    <field id="price_api_key" translate="label comment" type="obscure" sortOrder="9" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>CryptoCompare API Key</label>
                        <comment>Optional. Used for fiat to XMR conversion when no manual XMR rate is configured.</comment>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    </field>
                    <field id="manual_xmr_rate" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Manual XMR Rate</label>
                        <comment>Optional price of 1 XMR in the manual rate currency. Useful for local tests; leave blank for live rate lookup.</comment>
                        <validate>validate-number validate-greater-than-zero</validate>
                        <backend_model>MoneroIntegrations\Custompayment\Model\Config\Backend\PaymentSettings</backend_model>
                    </field>
                    <field id="manual_xmr_rate_currency" translate="label comment" type="text" sortOrder="11" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Manual XMR Rate Currency</label>
                        <comment>Three-letter currency code for the manual rate, such as USD. Required when Manual XMR Rate is set.</comment>
                        <validate>validate-alpha</validate>
                    </field>
                </group>
        </section>
    </system>
</config>
